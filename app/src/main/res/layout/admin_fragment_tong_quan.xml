<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_man_hinh"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            android:id="@+id/lblTieuDeTongQuan"
            style="@style/App.Text.HeadingLg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_bv_dashboard"
            android:drawablePadding="@dimen/space_sm"
            android:drawableTint="@color/mauTimChinh"
            android:text="Tổng quan hệ thống" />

        <TextView
            android:id="@+id/lblMoTaTongQuan"
            style="@style/App.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="Cập nhật theo dữ liệu mới nhất" />

        <ProgressBar
            android:id="@+id/pgbDangTai"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_md"
            android:indeterminateTint="@color/mauTimChinh"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_sm"
                android:layout_weight="1"
                android:background="@drawable/bg_stat_card_2"
                android:elevation="@dimen/elevation_md"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    style="@style/App.Text.OnGradient.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Doanh thu thực nhận hôm nay" />

                <TextView
                    android:id="@+id/lblDoanhThuHomNay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="0 VNĐ"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_heading"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/lblChiTietDoanhThuHomNay"
                    style="@style/App.Text.OnGradient.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="Gộp: 0 VNĐ • Giảm: 0 VNĐ" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:background="@drawable/bg_stat_card_1"
                android:elevation="@dimen/elevation_md"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    style="@style/App.Text.OnGradient.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Doanh thu thực nhận tháng này" />

                <TextView
                    android:id="@+id/lblDoanhThuThangNay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="0 VNĐ"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_heading"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/lblChiTietDoanhThuThangNay"
                    style="@style/App.Text.OnGradient.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="Gộp: 0 VNĐ • Giảm: 0 VNĐ" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/App.Text.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="Chỉ số nhanh" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lblHoaDonHomNay"
                style="@style/App.Text.Body"
                android:layout_width="0dp"
                android:layout_height="@dimen/stat_card_min_height"
                android:layout_marginEnd="@dimen/space_sm"
                android:layout_weight="1"
                android:background="@drawable/bg_card_modern"
                android:elevation="@dimen/elevation_sm"
                android:gravity="center"
                android:padding="@dimen/space_md"
                android:text="Hóa đơn hôm nay\n0"
                android:textAlignment="center"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lblHoaDonChoThanhToan"
                style="@style/App.Text.Body"
                android:layout_width="0dp"
                android:layout_height="@dimen/stat_card_min_height"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:background="@drawable/bg_card_modern"
                android:elevation="@dimen/elevation_sm"
                android:gravity="center"
                android:padding="@dimen/space_md"
                android:text="Chờ thanh toán\n0"
                android:textAlignment="center"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lblVeBanHomNay"
                style="@style/App.Text.Body"
                android:layout_width="0dp"
                android:layout_height="@dimen/stat_card_min_height"
                android:layout_marginEnd="@dimen/space_sm"
                android:layout_weight="1"
                android:background="@drawable/bg_card_modern"
                android:elevation="@dimen/elevation_sm"
                android:gravity="center"
                android:padding="@dimen/space_md"
                android:text="Vé bán hôm nay\n0"
                android:textAlignment="center"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lblVeBanThangNay"
                style="@style/App.Text.Body"
                android:layout_width="0dp"
                android:layout_height="@dimen/stat_card_min_height"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:background="@drawable/bg_card_modern"
                android:elevation="@dimen/elevation_sm"
                android:gravity="center"
                android:padding="@dimen/space_md"
                android:text="Vé bán tháng này\n0"
                android:textAlignment="center"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lblVeDangBan"
                style="@style/App.Text.Body"
                android:layout_width="0dp"
                android:layout_height="@dimen/stat_card_min_height"
                android:layout_marginEnd="@dimen/space_sm"
                android:layout_weight="1"
                android:background="@drawable/bg_card_modern"
                android:elevation="@dimen/elevation_sm"
                android:gravity="center"
                android:padding="@dimen/space_md"
                android:text="Vé đang bán\n0"
                android:textAlignment="center"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lblVoucherHoatDong"
                style="@style/App.Text.Body"
                android:layout_width="0dp"
                android:layout_height="@dimen/stat_card_min_height"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:background="@drawable/bg_card_modern"
                android:elevation="@dimen/elevation_sm"
                android:gravity="center"
                android:padding="@dimen/space_md"
                android:text="Voucher hoạt động\n0"
                android:textAlignment="center"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lblKhachHang"
                style="@style/App.Text.Body"
                android:layout_width="0dp"
                android:layout_height="@dimen/stat_card_min_height"
                android:layout_marginEnd="@dimen/space_sm"
                android:layout_weight="1"
                android:background="@drawable/bg_card_modern"
                android:elevation="@dimen/elevation_sm"
                android:gravity="center"
                android:padding="@dimen/space_md"
                android:text="Khách hàng\n0"
                android:textAlignment="center"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lblVeBanChay"
                style="@style/App.Text.Body"
                android:layout_width="0dp"
                android:layout_height="@dimen/stat_card_min_height"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:background="@drawable/bg_card_modern"
                android:elevation="@dimen/elevation_sm"
                android:gravity="center"
                android:maxLines="4"
                android:padding="@dimen/space_md"
                android:text="Bán chạy tháng này\nChưa đủ dữ liệu"
                android:textAlignment="center"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            style="@style/App.Text.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="Gợi ý nhanh" />

        <TextView
            android:id="@+id/lblGoiYNhanh"
            style="@style/App.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:layout_marginBottom="@dimen/space_xxl"
            android:background="@drawable/bg_card_modern"
            android:elevation="@dimen/elevation_sm"
            android:padding="@dimen/card_padding"
            android:text="Đang tải dữ liệu tổng quan..." />
    </LinearLayout>
</ScrollView>
