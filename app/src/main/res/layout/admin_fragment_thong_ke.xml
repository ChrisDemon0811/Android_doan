<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_man_hinh"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            android:id="@+id/lblTieuDeThongKe"
            style="@style/App.Text.HeadingLg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thống kê doanh thu" />

        <TextView
            style="@style/App.Text.BodySm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="Chọn ngày hoặc khoảng tháng để xem báo cáo chi tiết." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTuNgay"
                style="@style/App.Button.Outline"
                android:layout_width="0dp"
                android:layout_height="@dimen/btn_height"
                android:layout_weight="1"
                android:paddingStart="@dimen/space_sm"
                android:paddingEnd="@dimen/space_sm"
                android:text="Từ ngày" />

            <Button
                android:id="@+id/btnDenNgay"
                style="@style/App.Button.Outline"
                android:layout_width="0dp"
                android:layout_height="@dimen/btn_height"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:paddingStart="@dimen/space_sm"
                android:paddingEnd="@dimen/space_sm"
                android:text="Đến ngày" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnHomNay"
                style="@style/App.Button.Ghost"
                android:layout_width="0dp"
                android:layout_height="@dimen/btn_height_sm"
                android:layout_weight="1"
                android:paddingStart="@dimen/space_xs"
                android:paddingEnd="@dimen/space_xs"
                android:text="Hôm nay" />

            <Button
                android:id="@+id/btnThangNay"
                style="@style/App.Button.Ghost"
                android:layout_width="0dp"
                android:layout_height="@dimen/btn_height_sm"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:paddingStart="@dimen/space_xs"
                android:paddingEnd="@dimen/space_xs"
                android:text="Tháng này" />

            <Button
                android:id="@+id/btnThangTruoc"
                style="@style/App.Button.Ghost"
                android:layout_width="0dp"
                android:layout_height="@dimen/btn_height_sm"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:paddingStart="@dimen/space_xs"
                android:paddingEnd="@dimen/space_xs"
                android:text="Tháng trước" />
        </LinearLayout>

        <Button
            android:id="@+id/btnLoc"
            style="@style/App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="@dimen/space_sm"
            android:text="Lọc thống kê" />

        <Button
            android:id="@+id/btnPhanTichAI"
            style="@style/App.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="@dimen/space_sm"
            android:text="AI phân tích doanh thu" />

        <ProgressBar
            android:id="@+id/pgbDangTai"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_sm"
            android:indeterminateTint="@color/mauTimChinh"
            android:visibility="gone" />

        <TextView
            style="@style/App.Text.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="Tổng quan" />

        <TextView
            android:id="@+id/lblTongHoaDon"
            style="@style/App.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@drawable/bg_card_modern"
            android:elevation="@dimen/elevation_sm"
            android:padding="@dimen/card_padding"
            android:text="Tổng hóa đơn đã thanh toán: 0" />

        <TextView
            android:id="@+id/lblTongDoanhThu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@drawable/bg_stat_card_2"
            android:elevation="@dimen/elevation_sm"
            android:padding="@dimen/card_padding"
            android:text="Doanh thu gộp: 0 VNĐ"
            android:textColor="@color/white"
            android:textSize="@dimen/text_body_lg"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lblTongTienGiam"
            style="@style/App.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@drawable/bg_card_modern"
            android:elevation="@dimen/elevation_sm"
            android:padding="@dimen/card_padding"
            android:text="Tổng giảm giá: 0 VNĐ" />

        <TextView
            android:id="@+id/lblTongThanhTien"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@drawable/bg_stat_card_1"
            android:elevation="@dimen/elevation_sm"
            android:padding="@dimen/card_padding"
            android:text="Doanh thu thực nhận: 0 VNĐ"
            android:textColor="@color/white"
            android:textSize="@dimen/text_body_lg"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lblTongVeBan"
            style="@style/App.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@drawable/bg_card_modern"
            android:elevation="@dimen/elevation_sm"
            android:padding="@dimen/card_padding"
            android:text="Tổng vé bán: 0" />

        <TextView
            style="@style/App.Text.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="Theo loại vé" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcvThongKeLoaiVe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:nestedScrollingEnabled="false" />

        <TextView
            style="@style/App.Text.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="Theo ngày" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcvDoanhThuNgay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:nestedScrollingEnabled="false" />

        <TextView
            style="@style/App.Text.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="Theo tháng" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcvDoanhThuThang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:layout_marginBottom="@dimen/space_xxl"
            android:nestedScrollingEnabled="false" />
    </LinearLayout>
</ScrollView>
