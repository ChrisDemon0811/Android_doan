<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/space_sm"
    android:layout_marginTop="@dimen/space_sm"
    android:layout_marginEnd="@dimen/space_sm"
    android:background="@drawable/bg_card_accent"
    android:elevation="@dimen/elevation_sm"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="@dimen/card_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/lblTenVoucher"
            style="@style/App.Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Voucher" />

        <TextView
            android:id="@+id/lblTrangThaiVoucher"
            style="@style/App.Badge.Success"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:text="Đủ điều kiện" />
    </LinearLayout>

    <TextView
        android:id="@+id/lblMaGiamGia"
        style="@style/App.Text.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:text="Mã: VOUCHER" />

    <TextView
        android:id="@+id/lblMoTaGiam"
        style="@style/App.Text.Price"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:text="Giảm 0%" />

    <TextView
        android:id="@+id/lblDieuKienVoucher"
        style="@style/App.Text.BodySm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:text="Điều kiện áp dụng" />

    <TextView
        android:id="@+id/lblTienGiamThucTe"
        style="@style/App.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:text="Giảm thực tế: 0 VNĐ"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lblLyDoVoucher"
        style="@style/App.Text.BodySm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:text="Lý do" />
</LinearLayout>
