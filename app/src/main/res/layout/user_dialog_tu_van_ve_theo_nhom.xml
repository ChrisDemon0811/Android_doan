<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_modern"
        android:orientation="vertical"
        android:padding="@dimen/space_xxl">

        <TextView
            style="@style/App.Text.HeadingLg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_bv_ai"
            android:drawablePadding="@dimen/space_sm"
            android:drawableTint="@color/mauTimChinh"
            android:text="Tư vấn vé theo nhóm" />

        <TextView
            style="@style/App.Text.BodySm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="Nhập số lượng khách và ngày dự kiến sử dụng vé." />

        <LinearLayout
            android:id="@+id/layNguoiLon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/bg_card_modern"
            android:elevation="@dimen/elevation_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_md">

            <TextView
                style="@style/App.Text.Subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_bv_adult"
                android:drawablePadding="@dimen/space_sm"
                android:drawableTint="@color/mauTimChinh"
                android:text="Người lớn" />

            <Button
                android:id="@+id/btnGiamNL"
                style="@style/App.Button.Counter"
                android:layout_width="@dimen/counter_btn_size"
                android:layout_height="@dimen/counter_btn_size"
                android:contentDescription="Giảm số lượng người lớn"
                android:text="-" />

            <TextView
                android:id="@+id/lblSoLuongNL"
                style="@style/App.Text.Counter"
                android:layout_width="@dimen/counter_text_width"
                android:layout_height="wrap_content"
                android:text="0" />

            <Button
                android:id="@+id/btnTangNL"
                style="@style/App.Button.Counter"
                android:layout_width="@dimen/counter_btn_size"
                android:layout_height="@dimen/counter_btn_size"
                android:contentDescription="Tăng số lượng người lớn"
                android:text="+" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layTreEm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@drawable/bg_card_modern"
            android:elevation="@dimen/elevation_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_md">

            <TextView
                style="@style/App.Text.Subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_bv_child"
                android:drawablePadding="@dimen/space_sm"
                android:drawableTint="@color/mauTimChinh"
                android:text="Trẻ em" />

            <Button
                android:id="@+id/btnGiamTE"
                style="@style/App.Button.Counter"
                android:layout_width="@dimen/counter_btn_size"
                android:layout_height="@dimen/counter_btn_size"
                android:contentDescription="Giảm số lượng trẻ em"
                android:text="-" />

            <TextView
                android:id="@+id/lblSoLuongTE"
                style="@style/App.Text.Counter"
                android:layout_width="@dimen/counter_text_width"
                android:layout_height="wrap_content"
                android:text="0" />

            <Button
                android:id="@+id/btnTangTE"
                style="@style/App.Button.Counter"
                android:layout_width="@dimen/counter_btn_size"
                android:layout_height="@dimen/counter_btn_size"
                android:contentDescription="Tăng số lượng trẻ em"
                android:text="+" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layNguoiCaoTuoi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@drawable/bg_card_modern"
            android:elevation="@dimen/elevation_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_md">

            <TextView
                style="@style/App.Text.Subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_bv_senior"
                android:drawablePadding="@dimen/space_sm"
                android:drawableTint="@color/mauTimChinh"
                android:text="Người cao tuổi" />

            <Button
                android:id="@+id/btnGiamCT"
                style="@style/App.Button.Counter"
                android:layout_width="@dimen/counter_btn_size"
                android:layout_height="@dimen/counter_btn_size"
                android:contentDescription="Giảm số lượng người cao tuổi"
                android:text="-" />

            <TextView
                android:id="@+id/lblSoLuongCT"
                style="@style/App.Text.Counter"
                android:layout_width="@dimen/counter_text_width"
                android:layout_height="wrap_content"
                android:text="0" />

            <Button
                android:id="@+id/btnTangCT"
                style="@style/App.Button.Counter"
                android:layout_width="@dimen/counter_btn_size"
                android:layout_height="@dimen/counter_btn_size"
                android:contentDescription="Tăng số lượng người cao tuổi"
                android:text="+" />
        </LinearLayout>

        <EditText
            android:id="@+id/edtNgaySuDung"
            style="@style/App.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:clickable="true"
            android:drawableStart="@drawable/ic_bv_calendar"
            android:drawablePadding="@dimen/space_sm"
            android:drawableTint="@color/mauTimChinh"
            android:focusable="false"
            android:hint="Ngày sử dụng"
            android:inputType="none" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnHuy"
                style="@style/App.Button.Outline"
                android:layout_width="0dp"
                android:layout_height="@dimen/btn_height"
                android:layout_marginEnd="@dimen/space_sm"
                android:layout_weight="0.8"
                android:text="Hủy" />

            <Button
                android:id="@+id/btnNhanTuVan"
                style="@style/App.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="@dimen/btn_height"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1.2"
                android:maxLines="1"
                android:paddingStart="@dimen/space_md"
                android:paddingEnd="@dimen/space_md"
                android:textSize="@dimen/text_body"
                android:text="Nhận tư vấn" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
