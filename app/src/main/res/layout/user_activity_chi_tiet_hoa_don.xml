<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_man_hinh">

    <ScrollView
        android:id="@+id/layNoiDung"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_user"
                android:elevation="@dimen/elevation_lg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_md"
                android:paddingTop="@dimen/space_lg"
                android:paddingEnd="@dimen/space_xxl"
                android:paddingBottom="@dimen/space_lg">

                <ImageView
                    android:id="@+id/btnQuayLai"
                    android:layout_width="@dimen/icon_xl"
                    android:layout_height="@dimen/icon_xl"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Quay lại"
                    android:padding="@dimen/space_sm"
                    android:src="@drawable/ic_quay_lai" />

                <TextView
                    android:id="@+id/lblTieuDe"
                    style="@style/App.Text.OnGradient.Heading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:text="Chi tiết hóa đơn" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layThongTinHoaDon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/bg_card_modern"
                android:elevation="@dimen/elevation_md"
                android:orientation="vertical"
                android:padding="@dimen/card_padding_lg">

                <TextView
                    android:id="@+id/lblMaHoaDon"
                    style="@style/App.Text.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mã hóa đơn" />

                <TextView
                    android:id="@+id/lblNgayLap"
                    style="@style/App.Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="Ngày lập" />

                <TextView
                    android:id="@+id/lblTrangThai"
                    style="@style/App.Badge.Success"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="Trạng thái" />

                <TextView
                    android:id="@+id/lblHinhThuc"
                    style="@style/App.Text.BodySm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="Hình thức thanh toán" />

                <TextView
                    android:id="@+id/lblNguoiMua"
                    style="@style/App.Text.BodySm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="Người mua"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/lblVoucher"
                    style="@style/App.Text.BodySm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="Mã voucher"
                    android:visibility="gone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/space_md"
                    android:layout_marginBottom="@dimen/space_md"
                    android:background="@drawable/bg_divider" />

                <TextView
                    android:id="@+id/lblTongTien"
                    style="@style/App.Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tổng tiền trước giảm: 0 VNĐ" />

                <TextView
                    android:id="@+id/lblTienGiam"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="Tổng giảm giá: 0 VNĐ"
                    android:textColor="@color/mauThanhCong"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:id="@+id/lblThanhTien"
                    style="@style/App.Text.PriceLg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:background="@drawable/bg_price_badge"
                    android:padding="@dimen/space_md"
                    android:text="Thành tiền: 0 VNĐ" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layQrHoaDon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/bg_card_modern"
                android:elevation="@dimen/elevation_md"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/card_padding_lg">

                <TextView
                    style="@style/App.Text.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Mã QR hóa đơn" />

                <FrameLayout
                    android:layout_width="@dimen/qr_invoice_size"
                    android:layout_height="@dimen/qr_invoice_size"
                    android:layout_marginTop="@dimen/space_md"
                    android:background="@drawable/bg_qr_hoa_don">

                    <ImageView
                        android:id="@+id/imgQrHoaDon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:adjustViewBounds="true"
                        android:contentDescription="Mã QR xác thực hóa đơn"
                        android:scaleType="fitCenter"
                        android:visibility="invisible" />

                    <ProgressBar
                        android:id="@+id/pgbTaoQr"
                        android:layout_width="@dimen/icon_xl"
                        android:layout_height="@dimen/icon_xl"
                        android:layout_gravity="center" />
                </FrameLayout>

                <TextView
                    android:id="@+id/lblTrangThaiQr"
                    style="@style/App.Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:gravity="center"
                    android:text="Đang tạo mã QR hóa đơn" />

                <TextView
                    android:id="@+id/lblMaXacThuc"
                    style="@style/App.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:gravity="center"
                    android:textIsSelectable="true"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                style="@style/App.Text.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="Chi tiết vé" />

            <LinearLayout
                android:id="@+id/layDanhSachChiTietHoaDon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="vertical" />

            <ProgressBar
                android:id="@+id/pgbXuatPdf"
                android:layout_width="@dimen/icon_lg"
                android:layout_height="@dimen/icon_lg"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_lg"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnXuatPdf"
                style="@style/App.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:layout_marginTop="@dimen/space_md"
                android:enabled="false"
                android:text="Xuất PDF hóa đơn" />

            <Button
                android:id="@+id/btnDong"
                style="@style/App.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:layout_marginTop="@dimen/space_sm"
                android:layout_marginBottom="@dimen/space_xxl"
                android:text="Đóng" />
        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/pgbDangTai"
        android:layout_width="@dimen/icon_xl"
        android:layout_height="@dimen/icon_xl"
        android:layout_gravity="center"
        android:contentDescription="Đang tải chi tiết hóa đơn" />
</FrameLayout>
