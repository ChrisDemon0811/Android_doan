<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_man_hinh">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/img_detail_height">

            <ImageView
                android:id="@+id/imgAnhVe"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Ảnh vé"
                android:scaleType="centerCrop"
                android:src="@mipmap/ic_launcher" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/avatar_size_lg"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_overlay_bottom" />

            <ImageView
                android:id="@+id/btnQuayLai"
                android:layout_width="@dimen/icon_xl"
                android:layout_height="@dimen/icon_xl"
                android:layout_gravity="start|top"
                android:layout_marginStart="@dimen/space_md"
                android:layout_marginTop="@dimen/space_lg"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Quay lại"
                android:padding="@dimen/space_sm"
                android:src="@drawable/ic_quay_lai" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_lg"
            android:layout_marginTop="-24dp"
            android:layout_marginEnd="@dimen/space_lg"
            android:background="@drawable/bg_card_modern"
            android:elevation="@dimen/elevation_lg"
            android:orientation="vertical"
            android:padding="@dimen/card_padding_lg">

            <TextView
                android:id="@+id/lblTenVe"
                style="@style/App.Text.DisplaySm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tên vé" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/border_thin"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginBottom="@dimen/space_md"
                android:background="@drawable/bg_divider" />

            <TextView
                android:id="@+id/lblMoTa"
                style="@style/App.Text.BodyLg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mô tả" />

            <TextView
                android:id="@+id/lblThongTinVe"
                style="@style/App.Text.BodySm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="Thông tin vé" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_lg"
            android:layout_marginTop="@dimen/space_md"
            android:layout_marginEnd="@dimen/space_lg"
            android:background="@drawable/bg_price_badge"
            android:elevation="@dimen/elevation_md"
            android:orientation="vertical"
            android:padding="@dimen/card_padding_lg">

            <TextView
                style="@style/App.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bảng giá" />

            <TextView
                android:id="@+id/lblGiaNguoiLon"
                style="@style/App.Text.Price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="Người lớn: 0 VNĐ" />

            <TextView
                android:id="@+id/lblGiaTreEm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="Trẻ em: 0 VNĐ"
                android:textColor="@color/mauChuChinh"
                android:textSize="@dimen/text_subtitle" />

            <TextView
                android:id="@+id/lblGiaCaoTuoi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="Người cao tuổi: 0 VNĐ"
                android:textColor="@color/mauChuChinh"
                android:textSize="@dimen/text_subtitle" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_lg"
            android:layout_marginTop="@dimen/space_xl"
            android:layout_marginEnd="@dimen/space_lg"
            android:layout_marginBottom="@dimen/space_xxl"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnChonVe"
                style="@style/App.Button.Outline"
                android:layout_width="0dp"
                android:layout_height="@dimen/btn_height"
                android:layout_weight="1"
                android:text="Thêm vào giỏ" />

            <Button
                android:id="@+id/btnMuaNgay"
                style="@style/App.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="@dimen/btn_height"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:text="Mua ngay" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
