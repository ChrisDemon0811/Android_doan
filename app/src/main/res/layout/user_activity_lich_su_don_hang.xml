<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_man_hinh"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <!-- ═══ Header ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hero_user"
        android:elevation="@dimen/elevation_lg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_md"
        android:paddingTop="@dimen/space_lg"
        android:paddingEnd="@dimen/space_xl"
        android:paddingBottom="@dimen/space_lg">

        <ImageView
            android:id="@+id/btnQuayLai"
            android:layout_width="@dimen/icon_xl"
            android:layout_height="@dimen/icon_xl"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Quay lại"
            android:padding="@dimen/space_sm"
            android:src="@drawable/ic_quay_lai" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_sm"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lblTieuDe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📋 Lịch sử đơn hàng"
                style="@style/App.Text.OnGradient.Heading" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:text="Xem lại các đơn hàng đã thanh toán"
                style="@style/App.Text.OnGradient.Body" />
        </LinearLayout>
    </LinearLayout>

    <!-- ═══ Empty state ═══ -->
    <TextView
        android:id="@+id/lblTrong"
        style="@style/App.EmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xxl"
        android:background="@drawable/bg_card_modern"
        android:text="📋 Chưa có đơn hàng đã thanh toán"
        android:visibility="gone" />

    <!-- ═══ Danh sách ═══ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcvLichSuDonHang"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_md"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_sm" />
</LinearLayout>
